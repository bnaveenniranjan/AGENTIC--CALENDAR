# Root Gitignore

# Dependencies
node_modules/
*/node_modules/

# Environment variables
.env
.env.*
!.env.example

# Build outputs
dist/
build/
.next/
out/

# Database files
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal

# Logs & temp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
*.tsbuildinfo

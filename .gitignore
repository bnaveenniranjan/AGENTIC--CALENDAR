# ============================================================
# ROOT .gitignore — Agentic Calendar App
# ============================================================

# ----- Node / npm -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json

# ----- Environment variables (NEVER commit secrets) -----
.env
.env.*
!.env.example

# ----- Next.js -----
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# ----- TypeScript -----
dist/
*.tsbuildinfo

# ----- OS files -----
.DS_Store
Thumbs.db
desktop.ini

# ----- IDE / Editor -----
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ----- Logs -----
logs/
*.log

# ----- Vercel -----
.vercel

# ----- Misc -----
*.pem
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
